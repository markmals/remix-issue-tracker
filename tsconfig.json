{
    "compilerOptions": {
        "target": "ESNext",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "jsx": "react-jsx",
        "jsxImportSource": "remix/ui",
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "types": ["@types/node"],
        "paths": {
            "#/*": ["./app/*"]
        }
    },
    "include": ["**/*.ts", "**/*.tsx"],
    "exclude": ["dist"]
}
